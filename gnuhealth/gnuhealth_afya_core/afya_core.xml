<tryton>
    <data>
        <record model="ir.ui.menu" id="menu_afya">
            <field name="name">AfyaConnect</field>
            <field name="parent" ref="health.menu_health"/>
            <field name="sequence">50</field>
        </record>
        <record model="ir.action.act_window" id="act_afya_config">
            <field name="name">Afya Configuration</field>
            <field name="res_model">gnuhealth.afya.config</field>
        </record>
        <record model="ir.action.act_window" id="act_consent_record">
            <field name="name">Consent Records</field>
            <field name="res_model">gnuhealth.afya.consent_record</field>
        </record>
        <record model="ir.action.act_window" id="act_posthoc_consent">
            <field name="name">Post-Hoc Consent Tasks</field>
            <field name="res_model">gnuhealth.afya.posthoc_consent_task</field>
        </record>
        <record model="ir.ui.menu" id="menu_afya_config">
            <field name="name">Configuration</field>
            <field name="parent" ref="menu_afya"/>
            <field name="action" ref="act_afya_config"/>
        </record>
        <record model="ir.ui.menu" id="menu_afya_consent">
            <field name="name">Consent</field>
            <field name="parent" ref="menu_afya"/>
            <field name="action" ref="act_consent_record"/>
        </record>
        <record model="ir.ui.view" id="resolve_posthoc_start_view_form">
            <field name="model">gnuhealth.afya.resolve_posthoc_consent.start</field>
            <field name="type">form</field>
            <field name="name">resolve_posthoc_start_form</field>
            <field name="arch" type="xml">
                <![CDATA[
                <form string="Resolve Post-Hoc Consent">
                    <label name="resolution_consent"/>
                    <field name="resolution_consent"/>
                </form>
                ]]>
            </field>
        </record>
        <record model="ir.action.wizard" id="wizard_resolve_posthoc">
            <field name="name">Resolve Post-Hoc Consent</field>
            <field name="wiz_name">gnuhealth.afya.resolve_posthoc_consent</field>
        </record>
    </data>
</tryton>
